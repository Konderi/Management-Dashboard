# Nexus Infrastructure Control Plane Configuration
PORT=3001
NODE_ENV=production

# Ubiquiti Dream Machine SE & UniFi OS (VLAN 1 / VLAN 20)
UNIFI_HOST=https://192.168.1.1
UNIFI_USER=admin
UNIFI_PASS=your_unifi_password
UNIFI_SITE=default

# Aruba 2530-8G-PoE Switch - J9774A (Management VLAN 20)
ARUBA_HOST=https://192.168.20.2
ARUBA_USER=manager
ARUBA_PASS=your_aruba_password

# Proxmox VE - Standalone Control Node (pve-control) / Cluster (pve-01)
# Standalone Control Node: 192.168.50.15:8006 or Management IP: 192.168.20.15:8006
PROXMOX_HOST=https://192.168.50.15:8006
PVE_TOKEN_USER=root@pam!nexus
PVE_TOKEN_SECRET=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# Kubernetes Cluster (on Proxmox)
K8S_IN_CLUSTER=false
KUBECONFIG=

# AI Worker Nodes (Ollama & vLLM)
OLLAMA_HOST=http://192.168.50.21:11434
VLLM_HOST=http://192.168.50.22:8000

# Cloudflare Tunnel & Zero Trust (dashboard.konderi.fi)
CF_ACCOUNT_ID=
CF_API_TOKEN=
CF_TUNNEL_ID=
CF_TUNNEL_TOKEN=
CF_TEAM_NAME=konderi
CF_ZERO_TRUST_AUD=

# Local Access Fallback (for direct LAN / Ubiquiti WifiMan VPN access)
LOCAL_AUTH_PIN=1337

